# Supabase public browser client. These are built into the React app.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Worker runtime configuration for /api/admin.
# Upload these with scripts/sync-worker-secrets.ps1 or wrangler secret put.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORTFOLIO_ADMIN_PASSWORD=

# Cloudflare R2 / Wrangler local scripts.
# Dashboard -> My Profile -> API Tokens -> Create Token
# Suggested permission: Account / Workers R2 Storage / Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=cd77340c35e904beb65ed7a2dea6d21c

# Optional public R2 base URL if you enable r2.dev or a custom domain.
# REACT_APP_R2_PUBLIC_URL=
