# Supabase（留言板、喜欢 — 构建时打进前端，见 deploy.yml）
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# 喜欢应用读取表 portfolio_favorites（见 supabase/migrations/）

# 可选：与 Pages 对齐的 Worker 运行时密钥（留言板仅用 REACT_APP_*；用 scripts/sync-worker-secrets.ps1 上传）
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 / Wrangler（本地创建桶、上传 manifest，勿提交真实 token）
# Dashboard → My Profile → API Tokens → Create Token
# 权限建议：Account / Workers R2 Storage / Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=cd77340c35e904beb65ed7a2dea6d21c

# 可选：R2 公共访问域名（若桶开了自定义域或 r2.dev）
# REACT_APP_R2_PUBLIC_URL=
